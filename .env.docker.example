# Learning OS -- Docker Compose environment.
# Copy to `.env` (same directory as docker-compose.yml) and fill in.
# `docker compose` reads `.env` automatically. Never commit the real file.

# Host path to your Obsidian vault (or any folder of Markdown files).
# Bind-mounted into the backend container at /vault -- during onboarding,
# enter "/vault" as the vault path in the app, not this host path.
VAULT_HOST_PATH=/absolute/path/to/your/obsidian/vault

# Encrypts AI provider API keys at rest inside the container -- there is
# no OS keyring available in a Linux container (docs/TASKS.md T143).
# Generate one with: openssl rand -base64 32
KEYRING_CRYPTFILE_PASSWORD=
