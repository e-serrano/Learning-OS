# Learning OS -- Docker Compose environment.
# Copy to `.env` (same directory as docker-compose.yml) and fill in.
# `docker compose` reads `.env` automatically. Never commit the real file.

# Host path to your Obsidian vault (or any folder of Markdown files).
# Bind-mounted into the backend container at /vault -- during onboarding,
# enter "/vault" as the vault path in the app, not this host path.
VAULT_HOST_PATH=/absolute/path/to/your/obsidian/vault

# NOT an AI provider API key itself -- that's still entered normally in
# the onboarding wizard, same as a native install. This is the password
# that encrypts wherever those keys end up stored at rest inside the
# container: there is no OS keyring available in a Linux container the
# way there is on Windows/macOS, so an encrypted file takes its place
# (docs/TASKS.md T143). Required -- there is no default password, since a
# shared default baked into a distributed image would protect nothing.
# Generate one with: openssl rand -base64 32
KEYRING_CRYPTFILE_PASSWORD=
