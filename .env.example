# Learning OS — local development environment
# Copy to `.env` and adjust as needed. Never commit the real `.env` file.
# API credentials are NEVER stored here — they live in the OS keyring and are
# referenced from app_settings by `credential_ref` only.

LEARNINGOS_HOST=127.0.0.1
LEARNINGOS_PORT=8000
LEARNINGOS_DB_PATH=./data/learning_os.sqlite3
LEARNINGOS_CONFIG_PATH=./data/app_config.json
LEARNINGOS_LOG_LEVEL=INFO

# vault_path, AI provider, model and onboarding state are configured through
# the onboarding flow (see docs/API_SPEC.md #13), not via environment
# variables.
